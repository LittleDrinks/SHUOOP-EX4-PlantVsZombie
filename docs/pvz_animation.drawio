        <mxCell id="10" value="Animation\n- num (frame count)\n- SpriteInfo ani (row/col/index/delta)\n- anis[] (flag=2)\nUpdate(): clock.Tick()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="320" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="11" value="Timer&lt;Animation&gt;\nBind(delay, &amp;Animation::Add, this, persistant)\nTick(): timeGetTime()\n维护 lastTime 指针\n支持 Pause/Continue 修正" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="80" width="330" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="12" value="Animator : Component\n- animations: map&lt;string, Animation&amp;&gt;\n- aniNode: Animation*\nUpdate():\n  owner-&gt;SetAniSource(aniNode-&gt;GetAni())\n  aniNode-&gt;Update()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="80" width="330" height="170" as="geometry"/>
