          <mxGeometry x="60" y="320" width="320" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="21" value="SpriteRenderer : VisualComponent\nUpdate(): if bFetchAni\n  sprite = owner.aniSource\nRender(): crop by row/col/index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="320" width="360" height="110" as="geometry"/>
