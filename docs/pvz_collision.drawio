<mxfile host="app.diagrams.net" modified="2025-12-20T00:00:00.000Z" agent="Copilot" version="24.7.8" type="device">
  <diagram id="collision" name="Collision System">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="10" value="BoxCollider : Component\n- size, type\n- boxes(set&lt;BoxCollider*&gt;) 当前帧碰撞集合\n- GetCollisions(type) 返回 owner 列表\n构造/析构: 自动注册/注销" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="380" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="11" value="Global\nGameColliders : set&lt;BoxCollider*&gt;\nColliderZones[8][6] : vector&lt;BoxCollider*&gt;\n(用于分区加速，避免全 O(N^2))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="80" width="360" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="12" value="Collision Refresh (每帧)\n1) Clear each collider.boxes\n2) 遍历同区块 collider pairs\n3) Insert(other) if AABB overlap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="80" width="240" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="20" value="Gameplay usage\n例: Zombie.Update()\n- auto plants = box-&gt;GetCollisions(\"Plant\")\n- if not empty: stop + damage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="380" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="21" value="Debug\ncollisionPattern=true 时\nBoxCollider::DrawDebugLine()\n+ 编辑器网格线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="320" width="360" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="registered in" style="endArrow=block;html=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="10" target="11">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="iterates" style="endArrow=block;html=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="12" target="11">
          <mxGeometry relative="1" as="geometry"/>
