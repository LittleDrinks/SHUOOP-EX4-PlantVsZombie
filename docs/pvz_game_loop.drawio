<mxfile host="app.diagrams.net" modified="2025-12-20T00:00:00.000Z" agent="Copilot" version="24.7.8" type="device">
  <diagram id="loop" name="Game Loop">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="10" value="Init()\n- 读 engine/file.txt (编辑器开关)\n- initgraph(...)\n- BeginBatchDraw()\n- setbkmode/textstyle\n- 资源线程 ResourcePool.Init()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="360" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="11" value="Start() (编辑器界面)\n- 背景/按钮图片 loadimage\n- 选择 collisionPattern/logPattern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="70" width="340" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="12" value="Main Loop\nwhile(true):\n  Input()\n  Update()\n  CollisionRefresh()\n  Render()\n  Info()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="70" width="270" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="20" value="Input()\nMainController.PeekInfo()\n(读取 ExMessage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="240" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="21" value="Update()\nfor obj in GameObjects: obj.Update()\nfor comp in GameComponents: comp.Update()\n处理删除队列 GameObjects_/GameComponents_" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="300" width="360" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="22" value="CollisionRefresh()\n遍历 GameColliders / ColliderZones\n更新每个 BoxCollider 的 boxes 集合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="300" width="410" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="23" value="Render()\ncleardevice()\nif !pause:\n  for vc in GameRenders: vc.Render()\n  for widget in GamePainters: widget.Paint()\n  (debug: colliderPattern 绘制碰撞箱/网格)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="640" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="24" value="Pause/Continue\nPause(): 保存 pauseImage + pauseTime\nContinue(): 修正 GameLastTimes 中的 lastTime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
